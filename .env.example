# ---------------------------------------------------------------------------
# Waffiy — variables d'environnement de l'application mobile
# ---------------------------------------------------------------------------
# Copier ce fichier en .env. Les variables EXPO_PUBLIC_* sont inlinées dans le
# bundle : ne jamais y mettre de secret.

# URL du projet Supabase, par exemple https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Clé anonyme. C'est la SEULE clé qui a sa place dans l'application mobile :
# elle est publique par construction, la RLS fait la sécurité.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Ce qui ne doit JAMAIS figurer ici ni dans le code mobile
# ---------------------------------------------------------------------------
#   SUPABASE_SERVICE_ROLE_KEY  → secrets des Edge Functions uniquement
#   BREVO_SMTP_USER / _PASS    → tableau de bord Supabase, réglages SMTP
